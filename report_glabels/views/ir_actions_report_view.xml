<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="ir_actions_report_view_form_glabels"
        model="ir.ui.view"
    >
        <field name="name">ir.actions.report.view.form.glabels</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <!-- Шаблонът и CSV-то са над бележника: без тях формата не
                 печата нищо, а „Advanced“ човек не отваря -->
            <xpath expr="//sheet/notebook" position="before">
                <group
                    string="gLabels"
                    name="glabels"
                    invisible="report_type != 'glabels'"
                >
                    <group>
                        <field
                            name="glabels_template_file"
                            filename="glabels_template_filename"
                        />
                        <field name="glabels_template_filename" invisible="1" />
                        <field
                            name="glabels_csv_file"
                            filename="glabels_csv_filename"
                        />
                        <field name="glabels_csv_filename" invisible="1" />
                        <field
                            name="glabels_template"
                            invisible="glabels_template_file"
                        />
                    </group>
                    <group>
                        <field name="glabels_copies" />
                        <field name="glabels_crop_marks" />
                        <field name="glabels_outlines" />
                    </group>
                    <field
                        name="glabels_columns"
                        colspan="2"
                        invisible="not glabels_csv_file"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
